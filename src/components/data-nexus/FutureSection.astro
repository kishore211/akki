---
import { Icon } from 'astro-icon/components';
import SectionShell from './SectionShell.astro';
import EvolutionSlider from './EvolutionSlider.astro';
import { futureSignals } from '~/data/data-nexus';
---

<SectionShell
  id="future"
  eyebrow="Future Predictions · Autonomous warehousing + quantum mining"
  title="Autonomous systems inherit the infrastructure layer."
  subtitle="By 2035, data management shifts from manual administration to AI-guided orchestration, but the energy curve forces a new sustainability contract."
  tone="dark"
  chapter="02"
  stage="future-lab"
>
  <div class="grid gap-6 lg:grid-cols-3">
    {
      futureSignals.map((signal) => (
        <article class="nexus-card-hover rounded-3xl border border-white/10 bg-white/6 p-6 shadow-xl shadow-black/10">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-300/15 text-amber-200">
            <Icon name={signal.icon} class="h-6 w-6" />
          </div>
          <h3 class="mt-6 text-xl font-bold text-white">{signal.title}</h3>
          <p class="mt-3 text-base leading-7 text-slate-300">{signal.body}</p>
          {signal.meta && (
            <p class="mt-5 text-sm font-semibold uppercase tracking-[0.14em] text-teal-200">{signal.meta}</p>
          )}
        </article>
      ))
    }
  </div>

  <div
    class="future-network mt-10 overflow-hidden rounded-[2rem] border border-white/10 bg-white/6 p-6 shadow-2xl shadow-black/10 lg:p-8"
    data-future-network
  >
    <div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
      <div>
        <h3 class="mt-3 text-3xl font-bold text-white">Watch demand and autonomy climb together.</h3>
        <p class="mt-4 text-base leading-7 text-slate-300">
          The future story is not just faster models. It is a pressure system where agent density, warehouse autonomy,
          and energy demand rise at the same time.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        <div class="forecast-meter rounded-3xl border border-white/10 bg-slate-950/60 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Energy demand</p>
          <p
            class="mt-3 text-3xl font-black text-amber-200"
            data-future-counter
            data-counter-start="415"
            data-counter-target="1200"
            data-counter-suffix=" TWh"
          >
            415 TWh
          </p>
          <span class="mt-4 block h-2 overflow-hidden rounded-full bg-white/10">
            <span class="forecast-bar block h-full rounded-full bg-amber-300" data-future-bar style="width: 34%"></span>
          </span>
        </div>
        <div class="forecast-meter rounded-3xl border border-white/10 bg-slate-950/60 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Agent fabric</p>
          <p
            class="mt-3 text-3xl font-black text-cyan-200"
            data-future-counter
            data-counter-start="120"
            data-counter-target="900"
            data-counter-suffix="B"
          >
            120B
          </p>
          <span class="mt-4 block h-2 overflow-hidden rounded-full bg-white/10">
            <span class="forecast-bar block h-full rounded-full bg-cyan-300" data-future-bar style="width: 22%"></span>
          </span>
        </div>
        <div class="forecast-meter rounded-3xl border border-white/10 bg-slate-950/60 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Automation</p>
          <p
            class="mt-3 text-3xl font-black text-teal-200"
            data-future-counter
            data-counter-start="25"
            data-counter-target="90"
            data-counter-suffix="%"
          >
            25%
          </p>
          <span class="mt-4 block h-2 overflow-hidden rounded-full bg-white/10">
            <span class="forecast-bar block h-full rounded-full bg-teal-300" data-future-bar style="width: 28%"></span>
          </span>
        </div>
      </div>
    </div>

    <!-- Interactive Trend Chart -->
    <div class="trend-chart-wrap mt-8 rounded-[1.5rem] border border-white/10 bg-slate-950/60 p-5" data-trend-chart>
      <div class="mb-4 flex flex-wrap items-center gap-5">
        <span class="flex items-center gap-2 text-xs font-semibold text-amber-300">
          <span class="inline-block h-2 w-6 rounded-full bg-amber-400"></span>Energy Demand (TWh)
        </span>
        <span class="flex items-center gap-2 text-xs font-semibold text-cyan-300">
          <span class="inline-block h-2 w-6 rounded-full bg-cyan-400"></span>Agent Fabric (B)
        </span>
        <span class="flex items-center gap-2 text-xs font-semibold text-teal-300">
          <span class="inline-block h-2 w-6 rounded-full bg-teal-400"></span>Automation (%)
        </span>
      </div>

      <div class="relative" style="height: 200px;">
        <svg id="trend-svg" viewBox="0 0 800 200" preserveAspectRatio="none" class="absolute inset-0 h-full w-full" aria-label="Trend chart 2025 to 2035" role="img">
          <defs>
            <linearGradient id="energyGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgb(251 191 36 / 0.20)"/>
              <stop offset="100%" stop-color="rgb(251 191 36 / 0)"/>
            </linearGradient>
            <linearGradient id="agentGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgb(34 211 238 / 0.12)"/>
              <stop offset="100%" stop-color="rgb(34 211 238 / 0)"/>
            </linearGradient>
          </defs>
          <!-- Grid -->
          <line x1="0" y1="50" x2="800" y2="50" stroke="rgb(255 255 255 / 0.06)" stroke-width="1"/>
          <line x1="0" y1="100" x2="800" y2="100" stroke="rgb(255 255 255 / 0.06)" stroke-width="1"/>
          <line x1="0" y1="150" x2="800" y2="150" stroke="rgb(255 255 255 / 0.06)" stroke-width="1"/>
          <!-- Energy fill + path -->
          <path class="chart-fill" d="M0,185 L80,168 L160,148 L240,125 L320,100 L400,75 L480,52 L560,34 L640,20 L720,10 L800,5 L800,200 L0,200 Z" fill="url(#energyGrad)"/>
          <path id="line-energy" class="chart-path" d="M0,185 L80,168 L160,148 L240,125 L320,100 L400,75 L480,52 L560,34 L640,20 L720,10 L800,5" fill="none" stroke="rgb(251 191 36)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Agent fill + path -->
          <path class="chart-fill" d="M0,192 L80,182 L160,170 L240,154 L320,134 L400,110 L480,84 L560,58 L640,36 L720,18 L800,8 L800,200 L0,200 Z" fill="url(#agentGrad)"/>
          <path id="line-agent" class="chart-path" d="M0,192 L80,182 L160,170 L240,154 L320,134 L400,110 L480,84 L560,58 L640,36 L720,18 L800,8" fill="none" stroke="rgb(34 211 238)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Automation path -->
          <path id="line-auto" class="chart-path" d="M0,188 L80,176 L160,160 L240,140 L320,118 L400,93 L480,68 L560,46 L640,28 L720,16 L800,10" fill="none" stroke="rgb(45 212 191)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Crosshair + hover dots -->
          <line id="chart-crosshair" x1="-10" y1="0" x2="-10" y2="200" stroke="rgb(255 255 255 / 0.3)" stroke-width="1" stroke-dasharray="4 3"/>
          <circle id="dot-e" r="5" fill="rgb(251 191 36)" stroke="rgb(2 6 23)" stroke-width="2" cx="-20" cy="0"/>
          <circle id="dot-a" r="5" fill="rgb(34 211 238)" stroke="rgb(2 6 23)" stroke-width="2" cx="-20" cy="0"/>
          <circle id="dot-au" r="5" fill="rgb(45 212 191)" stroke="rgb(2 6 23)" stroke-width="2" cx="-20" cy="0"/>
        </svg>

        <!-- Tooltip -->
        <div id="chart-tooltip" class="pointer-events-none absolute z-10 hidden rounded-2xl border border-white/10 bg-slate-900/95 px-4 py-3 text-xs shadow-xl backdrop-blur" style="top:8px;left:0">
          <p id="tt-year" class="mb-2 font-bold text-white"></p>
          <p class="text-amber-300">⚡ <span id="tt-energy"></span> TWh</p>
          <p class="text-cyan-300">🤖 <span id="tt-agent"></span>B agents</p>
          <p class="text-teal-300">⚙️ <span id="tt-auto"></span>% automated</p>
        </div>
      </div>

      <div class="mt-2 flex justify-between px-1 text-xs font-semibold text-slate-500">
        {['2025','2027','2029','2031','2033','2035'].map(y => <span>{y}</span>)}
      </div>
    </div>
  </div>

  <div class="mt-12">
    <EvolutionSlider />
  </div>
</SectionShell>

<script>
  (() => {
    const years  = [2025, 2026, 2027, 2028, 2029, 2030, 2031, 2032, 2033, 2034, 2035];
    const energy = [415,  480,  560,  650,  740,  830,  920, 1000, 1080, 1145, 1200];
    const agents = [120,  200,  295,  390,  490,  600,  700,  780,  850,  900,  960];
    const auto   = [25,   32,   40,   50,   60,   68,   75,   81,   86,   89,   92];
    // SVG Y coords per year for each series (matches path points)
    const ePts  = [185, 168, 148, 125, 100,  75,  52,  34,  20,  10,   5];
    const aPts  = [192, 182, 170, 154, 134, 110,  84,  58,  36,  18,   8];
    const auPts = [188, 176, 160, 140, 118,  93,  68,  46,  28,  16,  10];

    const wrap = document.querySelector('[data-trend-chart]');
    if (!wrap) return;

    const svg       = wrap.querySelector('#trend-svg');
    const crosshair = wrap.querySelector('#chart-crosshair');
    const dotE      = wrap.querySelector('#dot-e');
    const dotA      = wrap.querySelector('#dot-a');
    const dotAu     = wrap.querySelector('#dot-au');
    const tooltip   = wrap.querySelector('#chart-tooltip');
    const ttYear    = wrap.querySelector('#tt-year');
    const ttEnergy  = wrap.querySelector('#tt-energy');
    const ttAgent   = wrap.querySelector('#tt-agent');
    const ttAuto    = wrap.querySelector('#tt-auto');

    // Animate paths on scroll into view
    const paths = Array.from(wrap.querySelectorAll('.chart-path'));
    paths.forEach((p) => {
      const len = p.getTotalLength ? p.getTotalLength() : 900;
      p.style.strokeDasharray  = len;
      p.style.strokeDashoffset = len;
      p.style.transition = 'stroke-dashoffset 1.8s cubic-bezier(0.4,0,0.2,1)';
    });
    const fills = Array.from(wrap.querySelectorAll('.chart-fill'));
    fills.forEach((f) => { f.style.opacity = '0'; f.style.transition = 'opacity 1.2s ease 0.6s'; });

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          paths.forEach((p) => { p.style.strokeDashoffset = '0'; });
          fills.forEach((f) => { f.style.opacity = '1'; });
          io.disconnect();
        }
      });
    }, { threshold: 0.25 });
    io.observe(wrap);

    // Hover tooltip
    svg.addEventListener('mousemove', (e) => {
      const rect  = svg.getBoundingClientRect();
      const xFrac = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      const i     = Math.round(xFrac * 10);
      const svgX  = (i / 10) * 800;

      crosshair.setAttribute('x1', svgX); crosshair.setAttribute('x2', svgX);
      dotE.setAttribute('cx', svgX);  dotE.setAttribute('cy',  ePts[i]);
      dotA.setAttribute('cx', svgX);  dotA.setAttribute('cy',  aPts[i]);
      dotAu.setAttribute('cx', svgX); dotAu.setAttribute('cy', auPts[i]);

      ttYear.textContent   = years[i];
      ttEnergy.textContent = energy[i].toLocaleString();
      ttAgent.textContent  = agents[i];
      ttAuto.textContent   = auto[i];

      const tipLeft = e.clientX - rect.left + 14;
      tooltip.style.left = (tipLeft + 190 > rect.width ? tipLeft - 210 : tipLeft) + 'px';
      tooltip.classList.remove('hidden');
    });

    svg.addEventListener('mouseleave', () => { tooltip.classList.add('hidden'); });
  })();
</script>

<style>
  .future-network {
    --future-progress: 0;
  }

  .forecast-bar {
    width: calc(22% + var(--future-progress, 0) * 72%);
    transition: width 180ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .forecast-bar { transition: none; }
    .chart-path, .chart-fill { transition: none !important; }
  }
</style>
