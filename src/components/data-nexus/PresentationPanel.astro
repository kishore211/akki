---
import * as QRCode from 'qrcode';
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { dilemmaChoices } from '~/data/data-nexus';

const configuredShowcaseUrl = String(import.meta.env.PUBLIC_SHOWCASE_URL || SITE.site || Astro.url.origin);
const showcaseUrl = new URL('/#overview', configuredShowcaseUrl).toString();
const pollEmbedUrl = String(import.meta.env.PUBLIC_POLL_EMBED_URL || '');
const hasPollEmbed = pollEmbedUrl.startsWith('https://') || pollEmbedUrl.startsWith('http://');
const joinCode = 'NEXUS-2035';
const qrSvg = await QRCode.toString(showcaseUrl, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 1,
  color: {
    dark: '#0f172a',
    light: '#ffffff',
  },
});
---

<article
  class="mission-control overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 text-white shadow-2xl shadow-slate-950/20 dark:border-white/10"
  data-presentation-panel
  data-mission-control
>
  <div class="grid gap-0 xl:grid-cols-[0.82fr_1.18fr]">
    <div class="relative isolate border-b border-white/10 p-6 xl:border-b-0 xl:border-r lg:p-8">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_10%,rgba(45,212,191,0.24),transparent_30%),linear-gradient(135deg,#020617,#0f172a_58%,#111827)]"
      >
      </div>

      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-200">Audience mission control</p>
          <h3 class="mt-3 text-3xl font-bold">Join, vote, and steer the showcase.</h3>
        </div>
        <span
          class="rounded-full border border-emerald-300/40 bg-emerald-300/12 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-emerald-100"
          data-mission-status
        >
          Room ready
        </span>
      </div>

      <div class="mt-7 grid gap-5 sm:grid-cols-[13rem_1fr] xl:grid-cols-1 2xl:grid-cols-[13rem_1fr]">
        <div>
          <div
            class="grid aspect-square place-items-center overflow-hidden rounded-3xl border border-white/10 bg-white p-4 shadow-2xl shadow-teal-950/40"
            role="img"
            aria-label={`QR code for ${showcaseUrl}`}
            set:html={qrSvg}
          />
          <a
            href={showcaseUrl}
            class="mt-3 block break-all rounded-2xl border border-white/10 bg-white/8 p-3 text-xs font-semibold leading-5 text-slate-200 hover:text-teal-100"
          >
            {showcaseUrl}
          </a>
        </div>

        <div class="grid content-between gap-4">
          <div class="rounded-3xl border border-white/10 bg-white/8 p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Join code</p>
            <p class="mt-2 text-4xl font-black text-white">{joinCode}</p>
            <p class="mt-3 text-sm leading-6 text-slate-300">
              Audience members scan the code, then use the live dilemma vote during the ethics section.
            </p>
          </div>

          <button
            type="button"
            class="inline-flex items-center justify-center gap-2 rounded-2xl bg-teal-300 px-5 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-teal-950/30 transition hover:bg-teal-200 focus:outline-none focus:ring-2 focus:ring-white"
            data-mission-start
          >
            <Icon name="tabler:player-play" class="h-5 w-5" />
            Open live room
          </button>
        </div>
      </div>
    </div>

    <div class="grid gap-5 bg-slate-900/80 p-6 lg:p-8 2xl:grid-cols-[1.1fr_0.9fr]">
      <div class="rounded-3xl border border-white/10 bg-slate-950/70 p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-200">Live dilemma vote</p>
            <h4 class="mt-3 text-2xl font-bold">Biometric signal response</h4>
          </div>
          <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-slate-300" data-vote-total
            >64 votes</span
          >
        </div>

        {
          hasPollEmbed ? (
            <iframe
              class="mt-5 h-full min-h-80 w-full rounded-2xl border border-white/10 bg-white"
              src={pollEmbedUrl}
              title="Live audience poll"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allow="clipboard-write; fullscreen"
            />
          ) : (
            <div class="mt-5 grid gap-3">
              {dilemmaChoices.map((choice, index) => {
                const seeds = [18, 11, 35];
                return (
                  <button
                    type="button"
                    class="mission-choice rounded-2xl border border-white/10 bg-white/6 p-4 text-left transition hover:-translate-y-0.5 hover:border-teal-300/70 hover:bg-teal-300/10 focus:outline-none focus:ring-2 focus:ring-teal-200"
                    data-mission-choice
                    data-choice-id={choice.id}
                    data-choice-label={choice.label}
                    data-seed={seeds[index]}
                    aria-pressed="false"
                  >
                    <span class="flex items-center justify-between gap-4">
                      <span>
                        <span class="text-sm font-bold text-white">
                          {index + 1}. {choice.label}
                        </span>
                        <span class="mt-1 block text-sm leading-6 text-slate-300">{choice.stance}</span>
                      </span>
                      <span class="text-lg font-black text-teal-200" data-choice-percent>
                        0%
                      </span>
                    </span>
                    <span class="mt-3 block h-2 overflow-hidden rounded-full bg-white/10">
                      <span
                        class="block h-full rounded-full bg-teal-300 transition-[width] duration-500"
                        data-choice-bar
                        style="width: 0%"
                      />
                    </span>
                  </button>
                );
              })}
            </div>
          )
        }

        <p
          class="mt-5 rounded-2xl border border-rose-300/20 bg-rose-300/10 p-4 text-sm leading-6 text-rose-50"
          data-mission-result
          aria-live="polite"
        >
          No room vote selected yet. Use this panel during the dilemma section to make the audience decision visible.
        </p>
      </div>

      <div class="grid gap-5">
        <div class="rounded-3xl border border-white/10 bg-white/6 p-5">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-cyan-200">Live exhibit meters</p>
          <div class="mt-5 grid gap-4">
            <div>
              <div class="flex justify-between text-sm font-semibold text-slate-200">
                <span>Interaction pulse</span>
                <span data-meter-interactions>0</span>
              </div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-white/10">
                <span
                  class="block h-full rounded-full bg-cyan-300 transition-[width] duration-500"
                  data-meter-interactions-bar
                  style="width: 12%"></span>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm font-semibold text-slate-200">
                <span>Scroll completion</span>
                <span data-meter-scroll>Showcase reached</span>
              </div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-white/10">
                <span
                  class="block h-full rounded-full bg-amber-300 transition-[width] duration-500"
                  data-meter-scroll-bar
                  style="width: 86%"></span>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-sm font-semibold text-slate-200">
                <span>Privacy-safe route</span>
                <span data-meter-route>ZKP ready</span>
              </div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-white/10">
                <span
                  class="block h-full rounded-full bg-emerald-300 transition-[width] duration-500"
                  style="width: 74%"></span>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/6 p-5">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-200">Presenter cue</p>
          <p class="mt-3 text-2xl font-bold" data-presenter-cue>
            Open with the QR, then scroll into the Global Data Pulse.
          </p>
          <p class="mt-3 text-sm leading-6 text-slate-300">
            This panel now mirrors the live story instead of ending the page with a static placeholder.
          </p>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/6 p-5">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-200">Live story trace</p>
          <ol class="mt-4 grid gap-2" data-mission-trace aria-live="polite">
            <li class="trace-item rounded-2xl border border-white/10 bg-slate-950/50 px-4 py-3 text-sm text-slate-300">
              Waiting for the first audience signal.
            </li>
          </ol>
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  import { initMissionControl } from '~/scripts/data-nexus/mission-control';

  document.addEventListener('astro:page-load', initMissionControl);
</script>

<style>
  .mission-control .mission-choice.is-active {
    border-color: rgb(45 212 191 / 0.84);
    background: rgb(45 212 191 / 0.14);
    box-shadow:
      inset 0 0 0 1px rgb(45 212 191 / 0.34),
      0 18px 60px rgb(20 184 166 / 0.14);
  }

  .mission-control[data-room-state='live'] [data-mission-status] {
    border-color: rgb(45 212 191 / 0.58);
    background: rgb(45 212 191 / 0.18);
    color: rgb(204 251 241);
  }

  .mission-control .trace-item {
    animation: traceRise 320ms ease both;
  }

  @keyframes traceRise {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mission-control .trace-item {
      animation: none;
    }
  }
</style>
