---
import * as QRCode from 'qrcode';
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { dilemmaChoices } from '~/data/data-nexus';

const configuredShowcaseUrl = String(import.meta.env.PUBLIC_SHOWCASE_URL || SITE.site || Astro.url.origin);
const showcaseUrl = new URL('/#overview', configuredShowcaseUrl).toString();
const pollEmbedUrl = String(import.meta.env.PUBLIC_POLL_EMBED_URL || '');
const hasPollEmbed = pollEmbedUrl.startsWith('https://') || pollEmbedUrl.startsWith('http://');
const qrSvg = await QRCode.toString(showcaseUrl, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 1,
  color: {
    dark: '#0f172a',
    light: '#ffffff',
  },
});
---

<article
  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5"
  data-presentation-panel
>
  <div class="flex items-center gap-3">
    <div
      class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-900 text-white dark:bg-white dark:text-slate-950"
    >
      <Icon name="tabler:qrcode" class="h-6 w-6" />
    </div>
    <div>
      <h3 class="text-xl font-bold text-slate-950 dark:text-white">Presenter QR and live poll</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400">Static-ready onboarding for the showcase room.</p>
    </div>
  </div>

  <div class="mt-6 grid gap-5 sm:grid-cols-[16rem_1fr] lg:grid-cols-1 xl:grid-cols-[16rem_1fr]">
    <div>
      <div
        class="grid aspect-square place-items-center overflow-hidden rounded-3xl border border-slate-200 bg-white p-4 shadow-inner dark:border-white/15"
        role="img"
        aria-label={`QR code for ${showcaseUrl}`}
        set:html={qrSvg}
      />
      <a
        href={showcaseUrl}
        class="mt-3 block break-all rounded-2xl bg-slate-100 p-3 text-xs font-semibold leading-5 text-slate-700 hover:text-teal-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:text-teal-200"
      >
        {showcaseUrl}
      </a>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4 dark:border-white/10 dark:bg-slate-950/70">
      {
        hasPollEmbed ? (
          <iframe
            class="h-full min-h-72 w-full rounded-2xl border border-slate-200 bg-white dark:border-white/10"
            src={pollEmbedUrl}
            title="Live audience poll"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allow="clipboard-write; fullscreen"
          />
        ) : (
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700 dark:text-teal-200">
              Live poll run sheet
            </p>
            <h4 class="mt-3 text-2xl font-bold text-slate-950 dark:text-white">Biometric signal vote</h4>
            <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
              Use the same three choices from the simulator for a room vote, or connect a Slido/Mentimeter embed through
              the public poll URL.
            </p>
            <div class="mt-5 grid gap-3">
              {dilemmaChoices.map((choice, index) => (
                <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-white/10 dark:bg-white/6">
                  <p class="text-sm font-bold text-slate-950 dark:text-white">
                    {index + 1}. {choice.label}
                  </p>
                  <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{choice.stance}</p>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</article>
