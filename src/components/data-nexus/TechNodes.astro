---
import { Icon } from 'astro-icon/components';
import { cryptoProtocols } from '~/data/data-nexus';
---

<div class="tech-nodes" data-tech-nodes>
  <div class="grid gap-6 lg:grid-cols-3" role="tablist" aria-label="Cryptographic protocols">
    {
      cryptoProtocols.map((protocol, index) => (
        <button
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          class="tech-node rounded-3xl border border-white/10 bg-white/6 p-6 text-left transition hover:-translate-y-1 hover:border-teal-300/60 focus:outline-none focus:ring-2 focus:ring-teal-300"
          data-tech-node={protocol.id}
          data-protocol={JSON.stringify(protocol)}
        >
          <span class="flex items-center justify-between gap-4">
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-300/15 text-teal-200">
              <Icon name={protocol.icon} class="h-7 w-7" />
            </span>
            <span class="rounded-full border border-white/10 px-3 py-1 text-sm font-bold text-amber-200">
              {protocol.shortName}
            </span>
          </span>
          <span class="mt-6 block text-xl font-bold text-white">{protocol.name}</span>
          <span class="mt-3 block text-sm leading-6 text-slate-300">{protocol.promise}</span>
        </button>
      ))
    }
  </div>

  <div
    class="mt-8 rounded-[2rem] border border-white/10 bg-slate-950/60 p-6 lg:p-8"
    data-tech-detail
    aria-live="polite"
  >
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-200" data-tech-kicker>Protocol node</p>
        <h3 class="mt-3 text-3xl font-bold text-white" data-tech-title>{cryptoProtocols[0].name}</h3>
        <p class="mt-4 text-base leading-7 text-slate-300" data-tech-mechanism>{cryptoProtocols[0].mechanism}</p>
        <p
          class="mt-4 rounded-2xl border border-amber-300/20 bg-amber-300/10 p-4 text-sm leading-6 text-amber-100"
          data-tech-risk
        >
          {cryptoProtocols[0].riskSolved}
        </p>
      </div>

      <div class="tech-flow grid gap-3 sm:grid-cols-4" data-tech-flow>
        {
          cryptoProtocols[0].flow.map((step) => (
            <div class="flow-step rounded-2xl border border-white/10 bg-white/6 p-4 text-center text-sm font-semibold text-white">
              {step}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import { initTechNodes } from '~/scripts/data-nexus/tech-nodes';

  document.addEventListener('astro:page-load', initTechNodes);
</script>

<style>
  .tech-nodes .tech-node.is-active {
    border-color: rgb(45 212 191 / 0.72);
    background: rgb(45 212 191 / 0.12);
  }

  .tech-nodes .flow-step {
    transform: translateY(0);
  }

  .tech-nodes .flow-step.is-animating {
    animation: nodePulse 560ms ease both;
  }

  @keyframes nodePulse {
    0% {
      transform: translateY(0) scale(1);
      background: rgb(255 255 255 / 0.06);
    }
    48% {
      transform: translateY(-0.35rem) scale(1.02);
      background: rgb(45 212 191 / 0.18);
    }
    100% {
      transform: translateY(0) scale(1);
      background: rgb(255 255 255 / 0.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-nodes .flow-step.is-animating {
      animation: none;
    }
  }
</style>
