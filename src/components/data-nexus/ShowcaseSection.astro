---
import { Icon } from 'astro-icon/components';
import SectionShell from './SectionShell.astro';
import { presentationPhases, sourceLinks, successMetrics } from '~/data/data-nexus';
---

<SectionShell
  id="showcase"
  eyebrow="Presentation and assessment"
  title="The delivery is part of the learning design."
  subtitle="The showcase format turns a static capstone brief into a shared exhibit: scan, explore, decide, and reflect."
>
  <div class="grid gap-6 lg:grid-cols-3">
    {
      presentationPhases.map((phase) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-100 text-sky-700 dark:bg-sky-400/15 dark:text-sky-200">
            <Icon name={phase.icon} class="h-6 w-6" />
          </div>
          <p class="mt-6 text-sm font-semibold uppercase tracking-[0.14em] text-amber-600 dark:text-amber-300">
            {phase.meta}
          </p>
          <h3 class="mt-2 text-xl font-bold text-slate-950 dark:text-white">{phase.title}</h3>
          <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">{phase.body}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-12 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5">
      <div class="flex items-center gap-3">
        <div
          class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-900 text-white dark:bg-white dark:text-slate-950"
        >
          <Icon name="tabler:qrcode" class="h-6 w-6" />
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-950 dark:text-white">Presenter QR and live poll</h3>
          <p class="text-sm text-slate-500 dark:text-slate-400">Configured for a static Vercel deployment.</p>
        </div>
      </div>
      <div
        class="mt-6 grid aspect-square place-items-center rounded-3xl border border-dashed border-slate-300 bg-slate-100 text-center dark:border-white/15 dark:bg-slate-900"
      >
        <div>
          <p class="text-5xl font-bold text-slate-950 dark:text-white">QR</p>
          <p class="mt-2 max-w-48 text-sm leading-6 text-slate-600 dark:text-slate-300">
            Replace this panel with the final Vercel URL or poll embed before presenting.
          </p>
        </div>
      </div>
    </article>

    <div class="grid gap-6">
      <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5">
        <h3 class="text-xl font-bold text-slate-950 dark:text-white">Success metrics</h3>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          {
            successMetrics.map((metric) => (
              <div class="rounded-2xl bg-slate-100 p-4 dark:bg-white/6">
                <p class="font-bold text-slate-950 dark:text-white">{metric.value}</p>
                <p class="mt-1 text-sm font-semibold uppercase tracking-[0.12em] text-teal-700 dark:text-teal-200">
                  {metric.label}
                </p>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{metric.detail}</p>
              </div>
            ))
          }
        </div>
      </article>

      <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5">
        <h3 class="text-xl font-bold text-slate-950 dark:text-white">Works cited anchor points</h3>
        <ul class="mt-5 grid gap-3">
          {
            sourceLinks.map((source) => (
              <li>
                <a
                  class="inline-flex items-center gap-2 text-sm font-semibold text-teal-700 hover:text-teal-900 dark:text-teal-200 dark:hover:text-white"
                  href={source.href}
                  target="_blank"
                  rel="noreferrer"
                >
                  <Icon name="tabler:external-link" class="h-4 w-4" />
                  {source.label}
                </a>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</SectionShell>
