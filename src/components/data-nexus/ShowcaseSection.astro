---
import { Icon } from 'astro-icon/components';
import SectionShell from './SectionShell.astro';
import { sourceLinks } from '~/data/data-nexus';
---

<SectionShell
  id="showcase"
  eyebrow="Epilogue"
  title="Author & Citations"
  subtitle="Thank you for exploring the future of data architecture and cognitive privacy."
  chapter="05"
  stage="mission-control"
>
  <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_0.65fr]">
    <!-- Presenter Profile -->
    <article
      class="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm dark:border-white/10 dark:bg-slate-900/40"
    >
      <!-- Decorative background glow -->
      <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-teal-400/10 blur-3xl"></div>

      <div class="relative z-10 flex flex-col items-start gap-8 md:flex-row md:items-center">
        <img
          src="/kishore.jpg"
          alt="Kishore Gantla"
          width="96"
          height="96"
          class="h-24 w-24 shrink-0 rounded-full object-cover object-top shadow-lg ring-4 ring-white dark:ring-slate-900"
        />

        <div class="flex-1">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-teal-600 dark:text-teal-400">Presented By</p>
          <h3 class="mt-1 text-3xl font-bold text-slate-950 dark:text-white">Kishore Gantla</h3>
          <p class="mt-1 text-base text-slate-500 dark:text-slate-400">
            Doctor of Education in Computer Science &middot; Judson University
          </p>

          <div class="mt-5 rounded-2xl border border-teal-400/20 bg-teal-400/5 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-teal-600 dark:text-teal-400">
              Course Assignment
            </p>
            <p class="mt-1 text-sm font-bold text-slate-800 dark:text-white">DCS725-1 SP 2025</p>
            <p class="mt-0.5 text-sm text-slate-600 dark:text-slate-300">Module Five: Ethics and Policy</p>
            <p class="mt-0.5 text-sm text-slate-600 dark:text-slate-300">
              Future of Data Warehousing and Mining &middot; Data Futures Showcase
            </p>
            <div class="mt-3 border-t border-teal-400/20 pt-3 flex items-center gap-2">
              <Icon name="tabler:user-check" class="h-4 w-4 shrink-0 text-teal-600 dark:text-teal-400" />
              <p class="text-sm text-slate-600 dark:text-slate-300">
                <span class="font-semibold text-slate-800 dark:text-white">Instructor:</span>
                Dr. Quiana Bradshaw
              </p>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- QR Code -->
    <article
      class="flex flex-col items-center justify-center rounded-[2rem] border border-slate-200 bg-slate-50 p-8 shadow-inner dark:border-white/10 dark:bg-black/20"
    >
      <a
        href="https://data-nexus-three.vercel.app"
        target="_blank"
        rel="noreferrer"
        class="group block rounded-3xl bg-white p-4 shadow-md ring-1 ring-slate-900/5 transition hover:ring-teal-400 dark:ring-white/10"
        aria-label="Open The Data Nexus exhibit"
      >
        <img
          src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://data-nexus-three.vercel.app&bgcolor=ffffff&color=020617&margin=4"
          alt="QR code for data-nexus-three.vercel.app"
          width="200"
          height="200"
          class="block rounded-xl"
          loading="lazy"
        />
      </a>
      <p class="mt-6 text-center text-sm font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">
        Scan to view exhibit
      </p>
      <a
        href="https://data-nexus-three.vercel.app"
        target="_blank"
        rel="noreferrer"
        class="mt-1 text-center text-xs text-teal-600 underline underline-offset-2 hover:text-teal-500 dark:text-teal-400"
      >
        data-nexus-three.vercel.app
      </a>
    </article>
  </div>

  <!-- Works Cited (Always Open) -->
  <div class="mt-12">
    <div class="rounded-3xl border border-white/10 bg-slate-950/60 p-8 shadow-xl shadow-black/20">
      <div class="mb-8 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-teal-400/15 text-teal-300">
          <Icon name="tabler:books" class="h-5 w-5" />
        </div>
        <div>
          <h3 class="text-xl font-bold text-white">Works Cited</h3>
          <p class="text-xs text-slate-400">{sourceLinks.length} sources referenced</p>
        </div>
      </div>

      <ol class="flex flex-col gap-4">
        {
          sourceLinks.map((source, i) => (
            <li>
              <a
                class="group flex items-start gap-4 rounded-2xl border border-white/6 bg-white/4 p-4 transition hover:border-teal-400/30 hover:bg-teal-400/5"
                href={source.href}
                target="_blank"
                rel="noreferrer"
              >
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-800 text-xs font-bold text-slate-400 ring-1 ring-white/10 group-hover:bg-teal-400/20 group-hover:text-teal-300">
                  {i + 1}
                </span>
                <span class="flex-1 text-sm leading-6 text-slate-300 group-hover:text-white">
                  {source.label}
                </span>
                <Icon
                  name="tabler:arrow-up-right"
                  class="mt-0.5 h-4 w-4 shrink-0 text-slate-500 transition group-hover:text-teal-400"
                />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</SectionShell>
