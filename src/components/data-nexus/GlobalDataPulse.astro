---
import { regionPulses } from '~/data/data-nexus';
---

<div
  class="global-pulse rounded-[2rem] border border-slate-200 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-white/5 lg:p-6"
  data-global-pulse
>
  <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
    <div class="relative isolate min-h-[28rem] overflow-hidden rounded-[1.5rem] bg-slate-950">
      <div
        class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle_at_50%_45%,rgba(20,184,166,0.2),transparent_42%),linear-gradient(135deg,rgba(15,23,42,0.1),rgba(2,6,23,0.58))]"
      >
      </div>
      <canvas
        class="absolute inset-0 z-10 h-full w-full touch-none"
        data-global-pulse-canvas
        aria-label="Interactive 3D global data pulse"></canvas>
      <div
        class="absolute inset-0 z-30 grid place-items-center bg-slate-950 text-center text-slate-200"
        data-global-pulse-loading
      >
        <div>
          <p class="text-lg font-bold">Preparing Global Data Pulse</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">The 3D scene loads as this module enters the timeline.</p>
        </div>
      </div>
      <div
        class="pulse-fallback absolute inset-0 z-30 hidden place-items-center p-6 text-slate-200"
        data-global-pulse-fallback
      >
        <div
          class="max-w-xl rounded-3xl border border-white/10 bg-slate-950/85 p-6 shadow-2xl shadow-black/30 backdrop-blur"
        >
          <p class="text-sm font-semibold uppercase text-teal-200">2D pulse fallback</p>
          <p class="mt-3 text-2xl font-bold">The regional controls still drive the exhibit.</p>
          <p class="mt-3 text-sm leading-6 text-slate-300">
            If WebGL is unavailable, use the pulse cards to inspect the same infrastructure, governance, and privacy
            pressure signals without losing the story.
          </p>
        </div>
      </div>
      <div
        class="pulse-tooltip pointer-events-none absolute left-4 top-4 z-30 w-[min(18rem,calc(100%-2rem))] rounded-2xl border border-white/10 bg-slate-950/90 p-4 text-sm text-white opacity-0 shadow-2xl backdrop-blur"
        data-global-pulse-tooltip
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute bottom-4 left-4 z-20 rounded-full border border-white/10 bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-teal-100 backdrop-blur"
      >
        Drag, hover, or select a region
      </div>
      <div
        class="pointer-events-none absolute right-4 top-4 z-20 rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-cyan-100 shadow-2xl backdrop-blur"
      >
        Blue Marble texture<br />live route arcs
      </div>
    </div>

    <div>
      <div class="flex items-center justify-between gap-4">
        <div>
          <h3 class="text-2xl font-bold text-slate-950 dark:text-white">Global Data Pulse</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">
            Regional examples link infrastructure choices to privacy and regulatory pressure.
          </p>
        </div>
      </div>

      <script is:inline type="application/json" data-pulse-regions set:html={JSON.stringify(regionPulses)} />
      <p class="sr-only" aria-live="polite" data-global-pulse-live>
        North America is selected in the Global Data Pulse.
      </p>

      <div class="mt-6 grid gap-3" role="list" aria-label="Global data pulse regions">
        {
          regionPulses.map((region) => (
            <button
              type="button"
              aria-pressed="false"
              class="pulse-region rounded-2xl border border-slate-200 bg-slate-50 p-4 text-left transition hover:-translate-y-0.5 hover:border-teal-300 hover:bg-teal-50 focus:outline-none focus:ring-2 focus:ring-teal-400 dark:border-white/10 dark:bg-slate-950/50 dark:hover:border-teal-300/70 dark:hover:bg-teal-300/10"
              data-region-button
              data-region-id={region.id}
            >
              <span class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full" style={`background-color: ${region.accent}`} />
                <span class="font-semibold text-slate-950 dark:text-white">{region.name}</span>
              </span>
              <span class="mt-2 block text-sm leading-6 text-slate-600 dark:text-slate-300">{region.pressure}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import { initGlobalDataPulse } from '~/scripts/data-nexus/global-data-pulse';

  document.addEventListener('astro:page-load', initGlobalDataPulse);
</script>

<style>
  .global-pulse .pulse-region.is-active {
    border-color: rgb(20 184 166 / 0.75);
    background-color: rgb(204 251 241) !important;
    box-shadow:
      inset 0 0 0 1px rgb(20 184 166 / 0.78),
      0 18px 54px rgb(20 184 166 / 0.2);
  }

  .global-pulse .pulse-region.is-active span {
    color: rgb(15 23 42);
  }

  :global(.dark) .global-pulse .pulse-region.is-active {
    background-color: rgb(20 184 166 / 0.18) !important;
  }

  :global(.dark) .global-pulse .pulse-region.is-active span {
    color: rgb(240 253 250);
  }

  @media (prefers-reduced-motion: reduce) {
    .global-pulse .pulse-region {
      transition: none;
    }
  }
</style>
