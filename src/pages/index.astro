---
import Layout from '~/layouts/PageLayout.astro';
import ExhibitHero from '~/components/data-nexus/ExhibitHero.astro';
import ExhibitBackdrop from '~/components/data-nexus/ExhibitBackdrop.astro';
import ExhibitAtmosphere from '~/components/data-nexus/ExhibitAtmosphere.astro';
import ExhibitProgress from '~/components/data-nexus/ExhibitProgress.astro';
import BaselineSection from '~/components/data-nexus/BaselineSection.astro';
import FutureSection from '~/components/data-nexus/FutureSection.astro';
import EthicsSection from '~/components/data-nexus/EthicsSection.astro';
import CryptoSection from '~/components/data-nexus/CryptoSection.astro';
import ShowcaseSection from '~/components/data-nexus/ShowcaseSection.astro';

const metadata = {
  title: 'The Data Nexus: Journey to 2035',
  ignoreTitleTemplate: true,
  description:
    'An interactive capstone exhibit exploring the future of data warehousing, mining, autonomous infrastructure, cognitive privacy, and privacy-preserving cryptography.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header"></Fragment>
  <ExhibitBackdrop />
  <ExhibitAtmosphere />
  <ExhibitProgress />
  <ExhibitHero />
  <BaselineSection />
  <FutureSection />
  <EthicsSection />
  <CryptoSection />
  <ShowcaseSection />

  <script>
    import { initDataNexusParallax } from '~/scripts/data-nexus/parallax';

    document.addEventListener('astro:page-load', () => {
      void initDataNexusParallax();
    });
  </script>
</Layout>
